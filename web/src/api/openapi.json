              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "actor_role": {
            "$ref": "#/components/schemas/AuditRole"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "metadata": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Metadata"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "actor_role",
          "action",
          "target_id",
          "created_at"
        ],
        "title": "AuditEntry"
      },
      "AuditRole": {
        "type": "string",
        "enum": [
          "analyst",
          "approver",
          "system"
        ],
        "title": "AuditRole"
      },
      "Batch": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "cause": {
            "$ref": "#/components/schemas/CauseFamily"
          },
          "remedy_code": {
            "type": "string",
            "title": "Remedy Code"
          },
          "unit_cost_bdt": {
            "type": "number",
            "title": "Unit Cost Bdt"
          },
          "wallet_count": {
            "type": "integer",
            "title": "Wallet Count"
          },
          "status": {
            "$ref": "#/components/schemas/BatchStatus"
          },
          "proposed_by": {
            "type": "string",
            "title": "Proposed By"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decision_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Note"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "sms": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SmsStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "cause",
          "remedy_code",
          "unit_cost_bdt",
          "wallet_count",
          "status",
          "proposed_by",
          "created_at"
        ],
        "title": "Batch"
      },
      "BatchStatus": {
        "type": "string",
        "enum": [
          "proposed",
          "approved",
          "rejected"
        ],
        "title": "BatchStatus"
      },
      "CauseFamily": {
        "type": "string",
        "enum": [
          "job_exit",
          "migration",
          "solved_problem",
          "fee_shock",
          "supply_failure"
        ],
        "title": "CauseFamily"
      },
      "Contribution": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution"
          }
        },
        "type": "object",
        "required": [
          "feature",
          "value",
          "contribution"
        ],
        "title": "Contribution"
      },
      "CreateBatchRequest": {
        "properties": {
          "cause": {
            "$ref": "#/components/schemas/CauseFamily"
          },
          "wallet_ids": {
            "items": {
              "type": "string",
              "pattern": "^W-[0-9A-Z]{6}$"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Wallet Ids"
          }
        },
        "type": "object",
        "required": [
          "cause",
          "wallet_ids"
        ],
        "title": "CreateBatchRequest"
      },
      "DecisionRequest": {
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "note"
        ],
        "title": "DecisionRequest"
      },
      "DeliveryResult": {
        "properties": {
          "delivered": {
            "type": "boolean",
            "title": "Delivered"
          },
          "status_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Code"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "delivered"
        ],
        "title": "DeliveryResult"
      },
      "ExportBatchResponse": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "cause": {
            "$ref": "#/components/schemas/CauseFamily"
          },
          "remedy_code": {
            "type": "string",
            "title": "Remedy Code"
          },
          "wallet_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Wallet Ids"
          },
          "cost_bdt": {
            "type": "number",
            "title": "Cost Bdt"
          },
          "approved_by": {
            "type": "string",
            "title": "Approved By"
          },
          "approved_at": {
            "type": "string",
            "title": "Approved At"
          }
        },
        "type": "object",
        "required": [
