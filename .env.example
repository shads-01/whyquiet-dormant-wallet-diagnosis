# WhyQuiet Environment Configuration (.env.example)
# Copy to .env (gitignored, never commit). Loaded by `uv run --env-file .env ...` / `make dev`.
# HARD RULE: NEVER commit real API keys or passwords.

# --- Application & Server Settings ---
API_HOST=0.0.0.0
API_PORT=8008
DASHBOARD_PORT=8501
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Optional LLM Paraphrasing Hook (Disabled by default) ---
# When disabled (default), WhyQuiet uses vetted template-first Bangla copy.
ENABLE_LLM_PARAPHRASE=false
GEMINI_API_KEY=your_gemini_api_key_placeholder

# --- Supabase Persistence (Optional for write-path governance & audit trail) ---
# Without Supabase, WhyQuiet operates in full offline/local mode with deterministic seed data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_placeholder
SUPABASE_ANON_KEY=your_anon_key_placeholder
SUPABASE_DB_PASSWORD=your_db_password_placeholder

# --- Demo Authentication Accounts (Local only, read by supabase/seed_demo_users.py) ---
DEMO_ANALYST_PASSWORD=your_analyst_password_placeholder
DEMO_APPROVER_PASSWORD=your_approver_password_placeholder